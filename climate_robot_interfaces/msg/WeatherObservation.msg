# One hourly WeatherSTEM observation, replayed from the cleaned dataset.
# Field names match the feature columns used to train the Milestone 2 models.
builtin_interfaces/Time stamp
string observation_time      # timestamp of the dataset row, "YYYY-MM-DD HH:MM:SS"
float64 temp_f
float64 humidity_pct
float64 wind_speed_mph
float64 wind_gust_mph
float64 rain_rate_in_hr
float64 pressure_inhg
float64 solar_rad_wm2
float64 uv_index
float64 wind_dir_deg
